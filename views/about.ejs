<!DOCTYPE html>
<html lang="<%= locale || 'en' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= __('about_page_title') %></title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <link rel="stylesheet" href="/css/about.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>


    <header class="navbar">
        <div class="container">

            <a href="/" class="logo">
                <i class="fas fa-leaf"></i> AgriMind
            </a>

            <button class="mobile-menu-toggle" id="mobile-menu-toggle">
                <i class="fas fa-bars"></i>
            </button>

            <ul class="nav-links" id="nav-links">

                <li>
                    <a href="/">
                        <%= __('nav_home') %>
                    </a>
                </li>

                <% if (isLoggedIn) { %>

                    <li id="dashboard-link">
                        <a href="/dashboard">
                            <%= __('nav_dashboard') %>
                        </a>
                    </li>

                    <li>
                        <a href="/irrigation">
                            <%= __('Irrigation') %>
                        </a>
                    </li>

                    <li>
                        <a href="/feedback">
                            <%= __('nav_feedback') %>
                        </a>
                    </li>

                <% } else { %>

                    <li id="dashboard-link" style="display:none;">
                        <a href="/dashboard">
                            <%= __('nav_dashboard') %>
                        </a>
                    </li>

                <% } %>

                <li>
                    <a href="/about">
                        <%= __('nav_about') %>
                    </a>
                </li>

                <li>
                    <a href="/analytics">
                        <%= __('nav_analytics') %>
                    </a>
                </li>

            </ul>


            <!-- Authentication -->

            <div class="auth-buttons">

                <% if (isLoggedIn && user) { %>

                    <div class="user-nav-profile">

                        <img
                            src="<%= user.profilePhoto %>"
                            alt="<%= __('user_profile') %>"
                            class="nav-avatar"
                        >

                        <span class="nav-username">
                            <%= user.name %>
                            <i class="fas fa-caret-down"></i>
                        </span>

                        <div class="user-dropdown-menu">

                            <a href="/profile">
                                <i class="fas fa-user-circle"></i>
                                <%= __('view_profile') %>
                            </a>

                            <a href="/dashboard">
                                <i class="fas fa-seedling"></i>
                                <%= __('nav_dashboard') %>
                            </a>

                            <form action="/logout" method="POST" style="margin: 0;">

                                <button type="submit" style="font-family: inherit;">
                                    <i class="fas fa-sign-out-alt"></i>
                                    <%= __('nav_logout') %>
                                </button>

                            </form>

                        </div>

                    </div>

                <% } else { %>

                    <a href="#" class="btn btn-secondary" id="login-btn">
                        <%= __('nav_login') %>
                    </a>

                    <a href="/signup" class="btn" id="register-btn">
                        <%= __('nav_signup') %>
                    </a>

                <% } %>

            </div>


            <!-- Language -->

            <li class="dropdown" style="list-style: none; margin-left: 20px;">

                <a href="#" class="dropbtn">
                    <i class="fas fa-globe"></i>
                    <%= __('language') %>
                </a>

                <div class="dropdown-content">

                    <a href="/lang/en">English</a>

                    <a href="/lang/hi">
                        हिन्दी (Hindi)
                    </a>

                    <a href="/lang/kn">
                        ಕನ್ನಡ (Kannada)
                    </a>

                </div>

            </li>

        </div>
    </header>


    <!-- ================= MAIN ================= -->

    <main class="page-content">


        <!-- ABOUT HEADER -->

        <div class="page-header">

            <div class="container">

                <h1>
                    <%= __('about_title') %>
                </h1>

                <p>
                    <%= __('about_subtitle') %>
                </p>

                <div class="header-decoration">

                    <div class="decoration-item">
                        <i class="fas fa-seedling"></i>
                    </div>

                    <div class="decoration-item">
                        <i class="fas fa-brain"></i>
                    </div>

                    <div class="decoration-item">
                        <i class="fas fa-chart-line"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- ABOUT CONTENT -->

        <div class="container about-content">


            <!-- PROBLEM STATEMENT -->

            <section class="about-section">

                <div class="section-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>

                <div class="section-content">

                    <h2>
                        <%= __('problem_title') %>
                    </h2>

                    <p>
                        <%= __('problem_desc') %>
                    </p>

                    <div class="problem-stats">

                        <div class="stat">
                            <h3>60%</h3>
                            <p>
                                <%= __('problem_stat_1') %>
                            </p>
                        </div>

                        <div class="stat">
                            <h3>40%</h3>
                            <p>
                                <%= __('problem_stat_2') %>
                            </p>
                        </div>

                        <div class="stat">
                            <h3>30%</h3>
                            <p>
                                <%= __('problem_stat_3') %>
                            </p>
                        </div>

                    </div>

                </div>

            </section>


            <!-- OUR MISSION -->

            <section class="about-section">

                <div class="section-icon">
                    <i class="fas fa-bullseye"></i>
                </div>

                <div class="section-content">

                    <h2>
                        <%= __('mission_title') %>
                    </h2>

                    <p>
                        <%= __('mission_desc') %>
                    </p>

                    <div class="mission-features">


                        <!-- AI POWERED -->

                        <div class="feature">

                            <i class="fas fa-robot"></i>

                            <h4>
                                <%= __('mission_ai_title') %>
                            </h4>

                            <p>
                                <%= __('mission_ai_desc') %>
                            </p>

                        </div>


                        <!-- DATA DRIVEN -->

                        <div class="feature">

                            <i class="fas fa-database"></i>

                            <h4>
                                <%= __('mission_data_title') %>
                            </h4>

                            <p>
                                <%= __('mission_data_desc') %>
                            </p>

                        </div>


                        <!-- SUSTAINABLE -->

                        <div class="feature">

                            <i class="fas fa-leaf"></i>

                            <h4>
                                <%= __('mission_sustainable_title') %>
                            </h4>

                            <p>
                                <%= __('mission_sustainable_desc') %>
                            </p>

                        </div>

                    </div>

                </div>

            </section>


            <!-- HOW AGRIMIND HELPS -->

            <section class="about-section">

                <div class="section-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>

                <div class="section-content">

                    <h2>
                        <%= __('helps_title') %>
                    </h2>

                    <p>
                        <%= __('helps_desc') %>
                    </p>

                    <div class="benefits-grid">


                        <!-- BETTER CROP SELECTION -->

                        <div class="benefit">

                            <i class="fas fa-seedling"></i>

                            <h4>
                                <%= __('benefit_crop_title') %>
                            </h4>

                            <p>
                                <%= __('benefit_crop_desc') %>
                            </p>

                        </div>


                        <!-- WEATHER INSIGHTS -->

                        <div class="benefit">

                            <i class="fas fa-cloud-sun"></i>

                            <h4>
                                <%= __('benefit_weather_title') %>
                            </h4>

                            <p>
                                <%= __('benefit_weather_desc') %>
                            </p>

                        </div>


                        <!-- IMPROVED PRODUCTIVITY -->

                        <div class="benefit">

                            <i class="fas fa-chart-line"></i>

                            <h4>
                                <%= __('benefit_productivity_title') %>
                            </h4>

                            <p>
                                <%= __('benefit_productivity_desc') %>
                            </p>

                        </div>


                        <!-- ACCESSIBLE -->

                        <div class="benefit">

                            <i class="fas fa-language"></i>

                            <h4>
                                <%= __('benefit_accessible_title') %>
                            </h4>

                            <p>
                                <%= __('benefit_accessible_desc') %>
                            </p>

                        </div>

                    </div>

                </div>

            </section>


            <!-- VISION -->

            <section class="team-section">

                <h2>
                    <%= __('vision_title') %>
                </h2>

                <p class="vision-text">
                    <%= __('vision_desc') %>
                </p>

            </section>


        </div>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="footer">

        <div class="container">

            <div class="footer-content">


                <!-- FOOTER BRAND -->

                <div class="footer-brand">

                    <a href="/" class="logo">
                        <i class="fas fa-leaf"></i>
                        AgriMind
                    </a>

                    <p>
                        <%= __('footer_desc') %>
                    </p>

                </div>


                <!-- FOOTER LINKS -->

                <div class="footer-links">


                    <!-- QUICK LINKS -->

                    <div class="footer-column">

                        <h4>
                            <%= __('footer_quick_links') %>
                        </h4>

                        <ul>

                            <li>
                                <a href="/">
                                    <%= __('nav_home') %>
                                </a>
                            </li>

                            <li>
                                <a href="/dashboard">
                                    <%= __('nav_dashboard') %>
                                </a>
                            </li>

                            <li>
                                <a href="/about">
                                    <%= __('nav_about') %>
                                </a>
                            </li>

                        </ul>

                    </div>


                    <!-- RESOURCES -->

                    <div class="footer-column">

                        <h4>
                            <%= __('footer_resources') %>
                        </h4>

                        <ul>

                            <li>
                                <a href="/analytics">
                                    <%= __('nav_analytics') %>
                                </a>
                            </li>

                            <li>
                                <a href="/feedback">
                                    <%= __('nav_feedback') %>
                                </a>
                            </li>

                            <li>
                                <a href="#">
                                    <%= __('footer_help') %>
                                </a>
                            </li>

                        </ul>

                    </div>


                    <!-- CONTACT -->

                    <div class="footer-column">

                        <h4>
                            <%= __('footer_contact') %>
                        </h4>

                        <ul>

                            <li>
                                <a href="mailto:support@agrimind.dev">
                                    support@agrimind.dev
                                </a>
                            </li>

                            <li>
                                <a href="tel:+911234567890">
                                    +91 123 456 7890
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </div>


            <!-- FOOTER BOTTOM -->

            <div class="footer-bottom">

                <p>
                    <%= __('footer_copyright') %>
                </p>

                <div class="social-icons">

                    <a href="#" aria-label="Facebook">
                        <i class="fab fa-facebook"></i>
                    </a>

                    <a href="#" aria-label="Twitter">
                        <i class="fab fa-twitter"></i>
                    </a>

                    <a href="#" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>

                    <a href="#" aria-label="LinkedIn">
                        <i class="fab fa-linkedin"></i>
                    </a>

                </div>

            </div>

        </div>

    </footer>


    <script src="/js/main.js"></script>

</body>
</html>